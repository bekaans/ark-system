# ARK - LiteLLM router icin API anahtarlari
# Bu dosyayi .env olarak kopyala ve gercek key'lerini yaz. .env asla commit edilmez.
#
# Ucretsiz anahtar alma adresleri:
#   Cerebras   -> https://cloud.cerebras.ai            (14.400 istek/gun ucretsiz)
#   Groq       -> https://console.groq.com             (1.000 istek/gun ucretsiz, en dusuk gecikme)
#   Google     -> https://aistudio.google.com/apikey    (1.500 istek/gun/model ucretsiz, kart istemez)
#   OpenRouter -> https://openrouter.ai/keys            (50 istek/gun hesap-paylasimli ucretsiz)
#   Anthropic  -> https://console.anthropic.com/settings/keys  (ucretli, son-care fallback - ayri bakiye gerekir)

CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Supabase -> https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: SADECE backend script'lerinde (RLS bypass icin). Asla frontend'e/commit'e girmez.
SUPABASE_SECRET_KEY=

# LiteLLM proxy kendi erisimini korumak icin (opsiyonel ama onerilir)
LITELLM_MASTER_KEY=sk-ark-degistir-bunu

# Kling.ai video uretimi -> https://kling.ai/app/membership/membership-plan
# (agents/ajan3/kling_to_frames.py + generate_kling_video.py)
KLING_API_KEY=

# Bexi Telegram bot -> BotFather'dan /newbot ile al
# (agents/bexi-telegram/hourly_digest.py, bridge.py, bridge.sh)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Randevu takvim otomasyonu -> Google Cloud Console'da servis hesabi
# olustur (ucretsiz, faturalama gerekmez), kurulum adimlari icin bkz.
# agents/ajan2/calendar_booking.py docstring'i
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Ajan Ar-Ge model karsilastirma -> https://build.nvidia.com (ucretsiz,
# kart istemez, 1000 kredi) - SADECE test/degerlendirme icin, canli
# musteri trafiginde KULLANILMAZ (bkz. agents/ajan-arge/model_bench.py)
NVIDIA_API_KEY=
