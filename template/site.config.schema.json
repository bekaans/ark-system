{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARK site.config.json semasi",
  "description": "3D/7D vitrin sitesi sablon motorunun okudugu tek config dosyasi. Ajan 3 (site-assembler) bu dosyayi Higgsfield + GSAP sablonuna gore derler.",
  "type": "object",
  "required": ["site_id", "tier", "business", "sections", "seo", "deploy"],
  "properties": {
    "site_id": {
      "type": "string",
      "description": "leads.business_id (Supabase) ile eslesir"
    },
    "tier": {
      "type": "string",
      "enum": ["3D", "7D"],
      "description": "3D: sektore ozel hazir gorsel/animasyon. 7D: musterinin kendi fotograflari kullanilir."
    },
    "business": {
      "type": "object",
      "required": ["name", "sector_code", "sector_name", "city", "phone"],
      "properties": {
        "name": {"type": "string"},
        "sector_code": {"type": "string", "description": "NACE Rev.2 kodu, orn. 45.1"},
        "sector_name": {"type": "string"},
        "city": {"type": "string"},
        "address": {"type": "string"},
        "phone": {"type": "string"},
        "whatsapp": {"type": "string"},
        "instagram": {"type": "string"},
        "email": {"type": "string"}
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "primary_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "secondary_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "font_heading": {"type": "string"},
        "font_body": {"type": "string"}
      }
    },
    "sections": {
      "type": "object",
      "required": ["hero", "services_grid", "animation_2", "social_proof", "contact"],
      "properties": {
        "hero": {
          "type": "object",
          "required": ["headline", "video_asset", "frame_count"],
          "properties": {
            "headline": {"type": "string"},
            "subheadline": {"type": "string"},
            "video_asset": {"type": "string", "description": "Higgsfield ciktisi frame-sequence klasoru/dosya yolu"},
            "frame_count": {"type": "integer", "minimum": 1}
          }
        },
        "services_grid": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {"type": "string"},
                  "description": {"type": "string"},
                  "icon": {"type": "string"}
                }
              }
            }
          }
        },
        "animation_2": {
          "type": "object",
          "required": ["video_asset", "frame_count"],
          "properties": {
            "video_asset": {"type": "string"},
            "frame_count": {"type": "integer", "minimum": 1}
          }
        },
        "social_proof": {
          "type": "object",
          "properties": {
            "testimonials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "author": {"type": "string"},
                  "text": {"type": "string"},
                  "rating": {"type": "integer", "minimum": 1, "maximum": 5}
                }
              }
            },
            "photos": {
              "type": "array",
              "items": {"type": "string"},
              "description": "SADECE 7D tier icin doldurulur - musterinin kendi fotograflari"
            }
          }
        },
        "contact": {
          "type": "object",
          "required": ["cta_text"],
          "properties": {
            "map_embed": {"type": "string"},
            "hours": {"type": "string"},
            "cta_text": {"type": "string"}
          }
        }
      }
    },
    "media": {
      "type": "object",
      "description": "7D tier icin musterinin kendi fotograflari - draft_outreach.py/dm-qualifier akisindan toplanir",
      "properties": {
        "customer_photos": {"type": "array", "items": {"type": "string"}},
        "product_photos": {"type": "array", "items": {"type": "string"}}
      }
    },
    "seo": {
      "type": "object",
      "required": ["meta_title", "meta_description", "target_keywords"],
      "description": "SEO 2.0 hizmetinin dayandigi alanlar - sektor+bolge hedefli organik siralama",
      "properties": {
        "meta_title": {"type": "string"},
        "meta_description": {"type": "string"},
        "target_keywords": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "description": "orn. ['Antalya oto galeri', 'Antalya ikinci el arac']"
        },
        "og_image": {"type": "string"}
      }
    },
    "deploy": {
      "type": "object",
      "required": ["subdomain", "status"],
      "properties": {
        "subdomain": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "review", "live"]}
      }
    }
  }
}
